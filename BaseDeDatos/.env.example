# Configuración local de conexión SQL Server.
# Copia este archivo como .env dentro de esta carpeta y ajusta los valores.
DB_SERVER=est04db
DB_PORT=1433
DB_DATABASE=SOE
DB_DRIVER=ODBC Driver 17 for SQL Server

# windows usa la cuenta de Windows que ejecuta Node.js.
# sql usa DB_USER y DB_PASSWORD.
DB_AUTHENTICATION=windows
DB_USER=
DB_PASSWORD=

DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=5000
DB_REQUEST_TIMEOUT=15000
